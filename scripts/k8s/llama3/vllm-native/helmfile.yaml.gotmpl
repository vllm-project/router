environments:
  istio: &I
    values:
      - gateway-configs/istio.yaml
  istioBench: &IB
    values:
      - gateway-configs/istio.yaml
      - gateway-configs/benchmarking.yaml
  kgateway: &KG
    values:
      - gateway-configs/kgateway.yaml
  default:
    <<: *IB

---

{{- $ns := .Namespace | default "llm-d-llama31-multinode" -}}
{{- $rn := (env "RELEASE_NAME_POSTFIX") | default "llama31-multinode" -}}
{{- $dpSize := 16 -}}
{{- $rpcPort := "13345" -}}
{{- $decodeFqdn := printf "ms-%s-llm-d-modelservice-decode.%s.svc.cluster.local" $rn $ns -}}

repositories:
  - name: llm-d-modelservice
    url: https://llm-d-incubation.github.io/llm-d-modelservice/
  - name: llm-d-infra
    url: https://llm-d-incubation.github.io/llm-d-infra/

releases:
  - name: {{ printf "infra-%s" $rn | quote }}
    namespace: {{ $ns }}
    chart: llm-d-infra/llm-d-infra
    version: v1.3.3
    installed: true
    labels:
      type: infrastructure
      kind: inference-stack
    values:
      {{- toYaml .Environment.Values | nindent 6 }}

  - name: {{ printf "ms-%s" $rn | quote }}
    namespace: {{ $ns }}
    chart: llm-d-modelservice/llm-d-modelservice
    version: v0.2.11
    installed: true
    needs:
      - {{ printf "infra-%s" $rn | quote }}
    values:
      - base-values.yaml
      - master-values.yaml
{{- if or (eq .Environment.Name "istioBench") (eq .Environment.Name "default") }}
      - gateway-configs/benchmarking.yaml
{{- end }}
    set:
      - name: "routing.parentRefs[0].name"
        value: {{ printf "infra-%s-inference-gateway" $rn | quote }}
    labels:
      kind: inference-stack

{{- range $i, $_ := until 15 }}
{{- $rank := add $i 1 }}
  - name: {{ printf "ms-%s-worker-rank-%02d" $rn $rank | quote }}
    namespace: {{ $ns }}
    chart: llm-d-modelservice/llm-d-modelservice
    version: v0.2.11
    installed: true
    needs:
      - {{ printf "infra-%s" $rn | quote }}
      - {{ printf "ms-%s" $rn | quote }}
    values:
      - base-values.yaml
      - decode:
          create: false
        prefill:
          parallelism:
            tensor: 1
            data: {{ $dpSize }}
          create: true
          replicas: 1
          monitoring:
            podmonitor:
              enabled: true
              portName: "metrics"
              path: "/metrics"
              interval: "30s"
          containers:
          - name: "vllm"
            image: ghcr.io/llm-d/llm-d-cuda:v0.3.0
            modelCommand: vllmServe
            args:
              - "--tensor-parallel-size"
              - "1"
              - "--data-parallel-size"
              - {{ printf "%d" $dpSize | quote }}
              - "--data-parallel-rank"
              - {{ printf "%d" $rank | quote }}
              - "--data-parallel-address"
              - {{ $decodeFqdn | quote }}
              - "--data-parallel-rpc-port"
              - {{ $rpcPort | quote }}
              - "--block-size"
              - "128"
              - "--max-model-len"
              - "32000"
              - "--disable-uvicorn-access-log"
            env:
              - name: VLLM_LOGGING_LEVEL
                value: DEBUG
            ports:
              - containerPort: 8000
                name: http
                protocol: TCP
              - containerPort: {{ $rpcPort | int }}
                name: rpc
                protocol: TCP
            resources:
              limits:
                memory: 400Gi
                cpu: "90"
                nvidia.com/gpu: "1"
              requests:
                memory: 400Gi
                cpu: "90"
                nvidia.com/gpu: "1"
            mountModelVolume: true
            volumeMounts:
            - name: metrics-volume
              mountPath: /.config
            - name: shm
              mountPath: /dev/shm
            - name: torch-compile-cache
              mountPath: /.cache
          volumes:
          - name: metrics-volume
            emptyDir: {}
          - name: shm
            emptyDir:
              medium: Memory
              sizeLimit: "16Gi"
          - name: torch-compile-cache
            emptyDir: {}
    labels:
      kind: inference-stack
{{- end }}
