{
  "model": "deepseek-ai/DeepSeek-V4.1-Flash-1017",
  "local_model_env": "KV_AWARE_HYBRID_DEEPSEEK_V4_1_FLASH_1017_MODEL",
  "worker_count": 1,
  "worker_health_timeout_sec": 3600,
  "protocols": [
    "http",
    "grpc"
  ],
  "worker_params": {
    "enable_prefix_caching": true,
    "prefix_caching_hash_algo": "sha256_cbor",
    "max_model_len": 4096,
    "max_num_batched_tokens": 4096,
    "language_model_only": true,
    "trust_remote_code": true,
    "tensor_parallel_size": 8,
    "kv_cache_dtype": "fp8",
    "block_size": 128
  },
  "router_params": {
    "--kv-hybrid-layout": {
      "ranks": [
        {
          "rank": 0,
          "hash_block_size": 128,
          "hash_seed": "0",
          "speculative_tokens": 0,
          "groups": [
            {
              "kind": "sliding_window_mla",
              "sliding_window": 128
            },
            {
              "kind": "sliding_window_mla",
              "sliding_window": 128
            },
            {
              "kind": "sliding_window_mla",
              "sliding_window": 128
            },
            {
              "kind": "sliding_window_mla",
              "sliding_window": 128
            },
            {
              "kind": "sliding_window_mla",
              "sliding_window": 128
            },
            {
              "kind": "mla_attention",
              "cache_role": "sparse",
              "tokens_per_state": "2"
            },
            {
              "kind": "scratch",
              "tokens_per_state": "1"
            }
          ]
        }
      ]
    }
  },
  "deployments": [
    "merge"
  ]
}
