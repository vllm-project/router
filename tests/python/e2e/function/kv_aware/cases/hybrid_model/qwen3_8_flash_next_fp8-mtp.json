{
  "model": "Qwen/Qwen3.8-Flash-Next-FP8",
  "local_model_env": "KV_AWARE_HYBRID_QWEN3_8_FLASH_NEXT_FP8_MODEL",
  "worker_count": 2,
  "worker_health_timeout_sec": 1800,
  "protocols": [
    "http",
    "grpc"
  ],
  "worker_params": {
    "enable_prefix_caching": true,
    "prefix_caching_hash_algo": "sha256_cbor",
    "prefix_match_unit": 16,
    "max_model_len": 8192,
    "max_num_batched_tokens": 8192,
    "language_model_only": true,
    "tensor_parallel_size": 2,
    "enforce_eager": true,
    "max_num_seqs": 8,
    "kv_cache_memory_bytes": 8589934592,
    "speculative_config": {
      "method": "mtp",
      "num_speculative_tokens": 3,
      "disable_eagle_block_drop": true
    }
  },
  "router_params": {
    "--kv-hybrid-layout": {
      "ranks": [
        {
          "rank": 0,
          "hash_block_size": 16,
          "hash_seed": "0",
          "partial_hash_hits": true,
          "speculative_tokens": 3,
          "groups": [
            {
              "kind": "mamba",
              "mamba_cache_mode": "align"
            },
            {
              "kind": "mamba",
              "mamba_cache_mode": "align"
            },
            {
              "kind": "mamba",
              "mamba_cache_mode": "align"
            },
            {
              "kind": "mamba",
              "mamba_cache_mode": "align"
            },
            {
              "kind": "scratch",
              "tokens_per_state": "1"
            },
            {
              "kind": "mla_attention",
              "cache_role": "sparse",
              "tokens_per_state": "4"
            }
          ],
          "hash_lookahead_tokens": 0,
          "tail_drop_groups": []
        }
      ]
    }
  },
  "deployments": [
    "1p1d_nixl"
  ]
}
