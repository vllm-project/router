{
  "model": "Qwen/Qwen3.5-4B",
  "local_model_env": "KV_AWARE_HYBRID_MODEL",
  "worker_count": 2,
  "protocols": [
    "http",
    "grpc"
  ],
  "worker_params": {
    "language_model_only": true,
    "enable_prefix_caching": true,
    "prefix_caching_hash_algo": "sha256_cbor",
    "prefix_match_unit": 16,
    "max_model_len": 4096,
    "max_num_batched_tokens": 4096,
    "max_num_seqs": 8,
    "kv_cache_memory_bytes": 4294967296
  },
  "router_params": {
    "--kv-hybrid-layout": {
      "ranks": [
        {
          "rank": 0,
          "hash_block_size": 16,
          "hash_seed": "0",
          "partial_hash_hits": true,
          "speculative_tokens": 0,
          "groups": [
            {
              "kind": "mamba",
              "mamba_cache_mode": "align"
            },
            {
              "kind": "mamba",
              "mamba_cache_mode": "align"
            },
            {
              "kind": "mamba",
              "mamba_cache_mode": "align"
            },
            {
              "kind": "full_attention"
            }
          ]
        }
      ]
    }
  },
  "deployments": [
    "colocated",
    "1p1d_nixl"
  ]
}
