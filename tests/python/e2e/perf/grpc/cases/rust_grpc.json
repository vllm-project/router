{
  "backend": "rust_grpc",
  "env": {
    "host": "127.0.0.1"
  },
  "router": {
    "bin": "target/release/vllm-router",
    "port": 16002,
    "prometheus_port": 29002
  },
  "worker": {
    "http_port": 18002,
    "grpc_port": 15002,
    "cli": [
      "--tensor-parallel-size", "2",
      "--enable-auto-tool-choice",
      "--tool-call-parser", "qwen3_xml",
      "--reasoning-parser", "qwen3",
      "--mm-encoder-tp-mode", "data",
      "--max-model-len", "262144",
      "--max-num-seqs", "128",
      "--gpu-memory-utilization", "0.9",
      "--enable-prefix-caching"
    ]
  },
  "bench": {
    "tokens": 131072,
    "max_tokens": 64,
    "timeout": 1800,
    "hit_rates": [0.0, 0.99],
    "waves": [
      {"concurrency": 4, "requests": 8},
      {"concurrency": 8, "requests": 16},
      {"concurrency": 12, "requests": 24},
      {"concurrency": 16, "requests": 32},
      {"concurrency": 64, "requests": 128}
    ]
  }
}
