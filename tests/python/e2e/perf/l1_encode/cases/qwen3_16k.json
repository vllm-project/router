{
  "model": "Qwen/Qwen3-0.6B",
  "env": {
    "host": "127.0.0.1",
    "cuda_visible_devices": "0"
  },
  "router": {
    "bin": "target/release/vllm-router",
    "port": 30000,
    "prometheus_port": 29000,
    "l1": ["on", "off"]
  },
  "worker": {
    "http_port": 8000,
    "grpc_port": 50051,
    "cli": [
      "--tensor-parallel-size", "1",
      "--max-model-len", "32768",
      "--max-num-seqs", "16",
      "--max-num-batched-tokens", "32768",
      "--gpu-memory-utilization", "0.90",
      "--enable-prefix-caching",
      "--default-chat-template-kwargs", "{\"enable_thinking\": false}"
    ]
  },
  "bench": {
    "tokens": 16384,
    "max_tokens": 64,
    "timeout": 1800,
    "shape": "turns",
    "turns": 8,
    "hit_rates": [0.0, 0.30, 0.99999],
    "waves": [
      {"concurrency": 1, "requests": 2},
      {"concurrency": 4, "requests": 8},
      {"concurrency": 8, "requests": 16},
      {"concurrency": 16, "requests": 32}
    ]
  }
}
