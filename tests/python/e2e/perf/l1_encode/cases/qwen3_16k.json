{
  "model": "Qwen/Qwen3.8-27B",
  "stack": {
    "router_bin": "target/release/vllm-router",
    "host": "127.0.0.1",
    "router_port": 30000,
    "worker_http_port": 8000,
    "worker_grpc_port": 50051,
    "prometheus_port": 29000,
    "cuda_visible_devices": "0,1"
  },
  "worker": {
    "cli": [
      "--tensor-parallel-size", "2",
      "--max-model-len", "32768",
      "--max-num-seqs", "4",
      "--max-num-batched-tokens", "32768",
      "--gpu-memory-utilization", "0.90",
      "--enable-prefix-caching",
      "--default-chat-template-kwargs", "{\"enable_thinking\": false}"
    ]
  },
  "bench": {
    "tokens": 16384,
    "max_tokens": 64,
    "timeout": 1800,
    "shape": "turns",
    "turns": 8
  },
  "waves": [
    {"hit_rate": 0.0, "concurrency": 1, "requests": 2},
    {"hit_rate": 0.0, "concurrency": 4, "requests": 8},
    {"hit_rate": 0.30, "concurrency": 1, "requests": 2},
    {"hit_rate": 0.30, "concurrency": 4, "requests": 8},
    {"hit_rate": 0.99999, "concurrency": 1, "requests": 2},
    {"hit_rate": 0.99999, "concurrency": 4, "requests": 8}
  ]
}
